# Sao chép thành .env (KHÔNG commit file .env)
PORT=3001
CORS_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=adminpassword
DB_NAME=restaurant_db
# true: tự tạo/sửa bảng theo entity (chỉ dùng khi phát triển)
DB_SYNC=true

# Bắt buộc. Tạo chuỗi ngẫu nhiên dài: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai
JWT_EXPIRES_IN=8h

# Mật khẩu mặc định cho tài khoản mẫu / tài khoản cũ chưa có mật khẩu
SEED_DEFAULT_PASSWORD=Admin@123
