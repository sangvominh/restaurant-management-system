# Sao chép thành .env (KHÔNG commit file .env)
PORT=3000
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005

# Backend chạy trên máy, kết nối PostgreSQL của docker-compose.yml dùng chung với nhóm.
DATABASE_URL=postgresql://restaurant:local_dev_only@127.0.0.1:5433/restaurant_dev?schema=public

# Bắt buộc. Tạo chuỗi ngẫu nhiên dài: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai
JWT_EXPIRES_IN=8h

# Job backend-init của Compose dùng để tạo Admin đầu tiên; db:seed cũng đọc các biến này.
SEED_ADMIN_EMAIL=a@gmail.com
SEED_DEFAULT_PASSWORD=doi-mat-khau-it-nhat-8-ky-tu
