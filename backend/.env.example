# Sao chép thành .env (KHÔNG commit file .env)
PORT=3001
CORS_ORIGIN=http://localhost:3000

# PostgreSQL theo cấu hình develop. Môi trường cũ dùng TypeORM cần database mới hoặc kế hoạch chuyển đổi riêng.
DATABASE_URL=postgresql://restaurant:local_dev_only@localhost:5433/restaurant_dev?schema=public

# Bắt buộc. Tạo chuỗi ngẫu nhiên dài: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai
JWT_EXPIRES_IN=8h

# Chỉ dùng khi chạy npm run db:seed, không tự tạo tài khoản lúc khởi động.
SEED_ADMIN_EMAIL=a@gmail.com
SEED_DEFAULT_PASSWORD=doi-mat-khau-it-nhat-8-ky-tu
