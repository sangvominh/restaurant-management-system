// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(30)
  name      String   @db.VarChar(200)
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tables               RestaurantTable[]
  warehouseLocations   WarehouseLocation[]
  goodsReceipts        GoodsReceipt[]
  materialIssues       MaterialIssue[]
  bomDetails           BomDetail[]
  productionOrders     ProductionOrder[]
  finishedGoodsIssues  FinishedGoodsIssue[]
  finishedGoodsDefects FinishedGoodsDefect[]

  @@map("branches")

  staff StaffUser[]
  menu MenuItem[]
  invoices Invoice[]
  stock StockBatch[]
  staff_kitchen_balances          staff_kitchen_balances[] @ignore
  staff_kitchen_production_starts staff_kitchen_production_starts[] @ignore
  staff_kitchen_receipts          staff_kitchen_receipts[] @ignore
  staff_kitchen_sources           staff_kitchen_sources[] @ignore
  staff_kitchen_waste             staff_kitchen_waste[] @ignore
  staff_processing_defects        staff_processing_defects[] @ignore
}

model RestaurantTable {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  code      String   @db.VarChar(30)
  name      String   @db.VarChar(100)
  capacity  Int
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([branchId, code])
  @@map("restaurant_tables")

  invoices Invoice[]
}

model Unit {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String  @unique @db.VarChar(50)
  baseUnitId       String? @map("base_unit_id") @db.Uuid
  conversionFactor Decimal @default(1) @map("conversion_factor") @db.Decimal(18, 6)
  status           String  @default("ACTIVE") @db.VarChar(20)

  baseUnit     Unit?  @relation("UnitConversion", fields: [baseUnitId], references: [id], onDelete: Restrict)
  derivedUnits Unit[] @relation("UnitConversion")

  materials            Material[]
  goodsReceiptDetails  GoodsReceiptDetail[]
  materialIssueDetails MaterialIssueDetail[]
  bomDetails           BomDetail[]

  @@map("units")
}

model Category {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String @db.VarChar(100)
  categoryType String @map("category_type") @db.VarChar(30)
  status       String @default("ACTIVE") @db.VarChar(20)

  materials Material[]

  @@unique([name, categoryType])
  @@map("categories")

    code String @unique @db.VarChar(20)
}

model Material {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String  @unique @db.VarChar(30)
  name     String  @db.VarChar(200)
  minStock Decimal @default(0) @map("min_stock") @db.Decimal(18, 3)
  status   String  @default("ACTIVE") @db.VarChar(20)

  unitId     String @map("unit_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  unit                 Unit                  @relation(fields: [unitId], references: [id], onDelete: Restrict)
  category             Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  lots                 MaterialLot[]
  goodsReceiptDetails  GoodsReceiptDetail[]
  materialIssueDetails MaterialIssueDetail[]
  bomDetails           BomDetail[]

  @@index([categoryId])
  @@map("materials")

  staff_demo_order_recipes staff_demo_order_recipes[] @ignore
}

model WarehouseLocation {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId     String @map("branch_id") @db.Uuid
  name         String @db.VarChar(150)
  locationType String @map("location_type") @db.VarChar(30)

  branch                 Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  balances               MaterialBalance[]
  goodsReceiptDetails    GoodsReceiptDetail[]
  inventoryMovements     InventoryMovement[]
  materialIssueDetails   MaterialIssueDetail[]
  finishedGoodsBalances  FinishedGoodsBalance[]
  finishedGoodsMovements FinishedGoodsMovement[]

  @@unique([branchId, name])
  @@map("warehouse_locations")

  materialAdjustments    MaterialAdjustment[]
}

model MaterialLot {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId String    @map("material_id") @db.Uuid
  lotCode    String    @map("lot_code") @db.VarChar(50)
  expiryDate DateTime? @map("expiry_date") @db.Date
  status     String    @default("ACTIVE") @db.VarChar(20)

  material             Material              @relation(fields: [materialId], references: [id], onDelete: Restrict)
  balances             MaterialBalance[]
  goodsReceiptDetails  GoodsReceiptDetail[]
  inventoryMovements   InventoryMovement[]
  materialIssueDetails MaterialIssueDetail[]

  @@unique([materialId, lotCode])
  @@map("material_lots")

  adjustments          MaterialAdjustment[]
  staff_kitchen_balances                staff_kitchen_balances[] @ignore
  staff_kitchen_order_consumptions      staff_kitchen_order_consumptions[] @ignore
  staff_kitchen_production_consumptions staff_kitchen_production_consumptions[] @ignore
  staff_kitchen_receipts                staff_kitchen_receipts[] @ignore
  staff_kitchen_sources                 staff_kitchen_sources[] @ignore
  staff_kitchen_waste                   staff_kitchen_waste[] @ignore
}

model MaterialBalance {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId    String  @map("location_id") @db.Uuid
  materialLotId String  @map("material_lot_id") @db.Uuid
  quantity      Decimal @default(0) @db.Decimal(18, 3)

  location    WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  materialLot MaterialLot       @relation(fields: [materialLotId], references: [id], onDelete: Restrict)

  @@unique([locationId, materialLotId])
  @@map("material_balances")
}

model Supplier {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code    String  @unique @db.VarChar(30)
  name    String  @db.VarChar(200)
  phone   String? @db.VarChar(20)
  email   String? @db.VarChar(150)
  address String?
  status  String  @default("ACTIVE") @db.VarChar(20)

  receipts GoodsReceipt[]

  @@map("suppliers")
}

model GoodsReceipt {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptCode String    @unique @map("receipt_code") @db.VarChar(50)
  supplierId  String    @map("supplier_id") @db.Uuid
  branchId    String    @map("branch_id") @db.Uuid
  status      String    @default("DRAFT") @db.VarChar(20)
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  postedAt    DateTime? @map("posted_at") @db.Timestamptz(3)

  supplier Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch   Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  details  GoodsReceiptDetail[]

  @@index([branchId, createdAt])
  @@map("goods_receipts")
}

model GoodsReceiptDetail {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId     String  @map("receipt_id") @db.Uuid
  materialId    String  @map("material_id") @db.Uuid
  materialLotId String  @map("material_lot_id") @db.Uuid
  locationId    String  @map("location_id") @db.Uuid
  unitId        String  @map("unit_id") @db.Uuid
  quantity      Decimal @db.Decimal(18, 3)
  unitPrice     Decimal @map("unit_price") @db.Decimal(18, 2)

  receipt     GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  material    Material          @relation(fields: [materialId], references: [id], onDelete: Restrict)
  materialLot MaterialLot       @relation(fields: [materialLotId], references: [id], onDelete: Restrict)
  location    WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  unit        Unit              @relation(fields: [unitId], references: [id], onDelete: Restrict)

  movement InventoryMovement?

  @@index([receiptId])
  @@map("goods_receipt_details")
}

model InventoryMovement {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptDetailId   String?  @unique @map("receipt_detail_id") @db.Uuid
  productionOrderId String?  @map("production_order_id") @db.Uuid
  materialLotId     String   @map("material_lot_id") @db.Uuid
  locationId        String   @map("location_id") @db.Uuid
  movementType      String   @map("movement_type") @db.VarChar(30)
  quantityBefore    Decimal  @map("quantity_before") @db.Decimal(18, 3)
  quantityChange    Decimal  @map("quantity_change") @db.Decimal(18, 3)
  quantityAfter     Decimal  @map("quantity_after") @db.Decimal(18, 3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  receiptDetail   GoodsReceiptDetail? @relation(fields: [receiptDetailId], references: [id], onDelete: Restrict)
  productionOrder ProductionOrder?    @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  materialLot     MaterialLot         @relation(fields: [materialLotId], references: [id], onDelete: Restrict)
  location        WarehouseLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([materialLotId, locationId])
  @@index([productionOrderId])
  @@map("inventory_movements")

  adjustmentLink  MaterialAdjustmentMovement?
  staffStockWaste StaffMaterialWaste?
  staffReturn StaffMaterialReturn?
}

model MaterialIssue {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issueCode String   @unique @map("issue_code") @db.VarChar(50)
  branchId  String   @map("branch_id") @db.Uuid
  status    String   @default("PENDING") @db.VarChar(20)
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  branch  Branch                @relation(fields: [branchId], references: [id])
  details MaterialIssueDetail[]

  @@map("material_issues")

  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
}

model MaterialIssueDetail {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issueId       String  @map("issue_id") @db.Uuid
  materialId    String  @map("material_id") @db.Uuid
  materialLotId String  @map("material_lot_id") @db.Uuid
  locationId    String  @map("location_id") @db.Uuid
  unitId        String  @map("unit_id") @db.Uuid
  quantity      Decimal @db.Decimal(18, 3)

  issue       MaterialIssue     @relation(fields: [issueId], references: [id])
  material    Material          @relation(fields: [materialId], references: [id])
  materialLot MaterialLot       @relation(fields: [materialLotId], references: [id])
  location    WarehouseLocation @relation(fields: [locationId], references: [id])
  unit        Unit              @relation(fields: [unitId], references: [id])

  @@map("material_issue_details")

  adjustments MaterialAdjustment[]
  settlement  MaterialUsageSettlement?
  staff_kitchen_receipts staff_kitchen_receipts? @ignore
  materialReturns StaffMaterialReturn[]
}

model Bom {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String   @unique @db.VarChar(50)
  productCode    String   @map("product_code") @db.VarChar(50)
  version        Int      @default(1)
  outputQuantity Decimal  @default(1) @map("output_quantity") @db.Decimal(18, 3)
  status         String   @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product          Product?          @relation(fields: [productCode], references: [code])
  details          BomDetail[]
  productionOrders ProductionOrder[]

  @@unique([productCode, version])
  @@map("boms")

  productName    String?  @map("product_name") @db.VarChar(150)
}

model BomDetail {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bomId      String  @map("bom_id") @db.Uuid
  materialId String  @map("material_id") @db.Uuid
  unitId     String  @map("unit_id") @db.Uuid
  quantity   Decimal @db.Decimal(18, 3)

  bom              Bom               @relation(fields: [bomId], references: [id])
  material         Material          @relation(fields: [materialId], references: [id])
  unit             Unit              @relation(fields: [unitId], references: [id])
  branch           Branch?           @relation(fields: [branchId], references: [id])
  productionOrders ProductionOrder[]
  branchId         String?           @db.Uuid

  @@unique([bomId, materialId])
  @@map("bom_details")
}

model ProductionOrder {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique @db.VarChar(50)

  bomId    String @map("bom_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  productionMode String  @map("production_mode") @db.VarChar(30)
  quantity       Decimal @db.Decimal(18, 3)

  status         String   @default("NEW") @db.VarChar(20)
  materialStatus String   @default("UNCHECKED") @map("material_status") @db.VarChar(20)
  note           String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  assignedEmployeeCode String?               @map("assigned_employee_code") @db.VarChar(50)
  assignedAt           DateTime?             @map("assigned_at") @db.Timestamptz(3)

  bom                Bom                 @relation(fields: [bomId], references: [id], onDelete: Restrict)
  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  bomDetail          BomDetail?          @relation(fields: [bomDetailId], references: [id])
  bomDetailId        String?             @db.Uuid
  inventoryMovements InventoryMovement[]

  @@index([branchId, status])
  @@index([bomId])
  @@map("production_orders")

  finishedGoodsReceipts FinishedGoodsReceipt[]
  staff_kitchen_production_consumptions staff_kitchen_production_consumptions[] @ignore
  staff_kitchen_production_starts       staff_kitchen_production_starts? @ignore
  staff_processing_defects              staff_processing_defects[] @ignore
}

model FinishedGoodsReceipt {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String @unique @db.VarChar(50)
  productionOrderId String @map("production_order_id") @db.Uuid

  reportedQuantity Decimal  @map("reported_quantity") @db.Decimal(18, 3)
  acceptedQuantity Decimal? @map("accepted_quantity") @db.Decimal(18, 3)

  status           String    @default("PENDING") @db.VarChar(20)
  note             String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(3)
  rejectedQuantity Decimal?  @map("rejected_quantity") @db.Decimal(18, 3)
  inspectionNote   String?   @map("inspection_note") @db.Text
  inspectedAt      DateTime? @map("inspected_at") @db.Timestamptz(3)

  movement        FinishedGoodsMovement?
  wasteRequest    WasteRequest?
  productionOrder ProductionOrder        @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("finished_goods_receipts")

  staff_kitchen_production_consumptions staff_kitchen_production_consumptions[] @ignore
}

model FinishedGoodsBalance {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productCode String  @map("product_code") @db.VarChar(50)
  locationId  String  @map("location_id") @db.Uuid
  quantity    Decimal @default(0) @db.Decimal(18, 3)

  product  Product?          @relation(fields: [productCode], references: [code])
  location WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([productCode, locationId])
  @@map("finished_goods_balances")
}

model FinishedGoodsIssue {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String    @unique @db.VarChar(50)
  branchId   String    @map("branch_id") @db.Uuid
  shiftCode  String    @map("shift_code") @db.VarChar(50)
  status     String    @default("PENDING") @db.VarChar(20)
  note       String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(3)
  rejectedAt DateTime? @map("rejected_at") @db.Timestamptz(3)

  branch  Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  details FinishedGoodsIssueDetail[]

  @@index([branchId, shiftCode, status])
  @@index([status, createdAt])
  @@map("finished_goods_issues")
}

model FinishedGoodsIssueDetail {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issueId           String   @map("issue_id") @db.Uuid
  productCode       String   @map("product_code") @db.VarChar(50)
  requestedQuantity Decimal  @map("requested_quantity") @db.Decimal(18, 3)
  approvedQuantity  Decimal? @map("approved_quantity") @db.Decimal(18, 3)

  issue     FinishedGoodsIssue      @relation(fields: [issueId], references: [id], onDelete: Restrict)
  product   Product                 @relation(fields: [productCode], references: [code], onDelete: Restrict)
  movements FinishedGoodsMovement[]

  @@unique([issueId, productCode])
  @@index([productCode])
  @@map("finished_goods_issue_details")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(200)
  category    String   @db.VarChar(100)
  price       Decimal  @db.Decimal(18, 2)
  unit        String   @default("phần") @db.VarChar(50)
  imageUrl    String?  @map("image_url") @db.Text
  description String?  @db.Text
  status      String   @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  boms                      Bom[]
  finishedGoodsBalances     FinishedGoodsBalance[]
  finishedGoodsIssueDetails FinishedGoodsIssueDetail[]
  finishedGoodsDefects      FinishedGoodsDefect[]

  @@index([category, status])
  @@map("products")
}

model FinishedGoodsMovement {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId      String?  @unique @map("receipt_id") @db.Uuid
  issueDetailId  String?  @map("issue_detail_id") @db.Uuid
  defectId       String?  @map("defect_id") @db.Uuid
  productCode    String   @map("product_code") @db.VarChar(50)
  locationId     String   @map("location_id") @db.Uuid
  quantityBefore Decimal  @map("quantity_before") @db.Decimal(18, 3)
  quantityChange Decimal  @map("quantity_change") @db.Decimal(18, 3)
  quantityAfter  Decimal  @map("quantity_after") @db.Decimal(18, 3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  receipt     FinishedGoodsReceipt?     @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  issueDetail FinishedGoodsIssueDetail? @relation(fields: [issueDetailId], references: [id], onDelete: Restrict)
  defect      FinishedGoodsDefect?      @relation(fields: [defectId], references: [id], onDelete: Restrict)

  location WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([issueDetailId])
  @@index([defectId])
  @@map("finished_goods_movements")
}

model FinishedGoodsDefect {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String    @unique @db.VarChar(60)
  branchId        String    @map("branch_id") @db.Uuid
  productCode     String    @map("product_code") @db.VarChar(50)
  quantity        Decimal   @db.Decimal(18, 3)
  reason          String    @db.Text
  deductFromStock Boolean   @default(false) @map("deduct_from_stock")
  status          String    @default("PENDING") @db.VarChar(20)
  decisionNote    String?   @map("decision_note") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)

  branch    Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product   Product                 @relation(fields: [productCode], references: [code], onDelete: Restrict)
  movements FinishedGoodsMovement[]

  @@index([status, createdAt])
  @@index([branchId, productCode])
  @@map("finished_goods_defects")
}

model WasteRequest {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String    @unique @db.VarChar(60)
  receiptId    String    @unique @map("receipt_id") @db.Uuid
  quantity     Decimal   @db.Decimal(18, 3)
  reason       String    @db.Text
  status       String    @default("PENDING") @db.VarChar(20)
  decisionNote String?   @map("decision_note") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt  DateTime? @map("processed_at") @db.Timestamptz(3)

  receipt FinishedGoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("waste_requests")
}

enum AccountStatus {
  active
  locked
}

enum CategoryStatus {
  active
  inactive
}

enum LoginStatus {
  success
  failed
  locked
}

model Role {
  portal String @default("warehouse") @db.VarChar(20)
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String    @default("")
  isSystem    Boolean   @default(false) @map("is_system")
  permissions String[]  @default([])
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  accounts    Account[]

  @@map("roles")
}

// ID số giữ tương thích API/JSON cũ; roleId là FK, không lưu tên vai trò tự do.
model Account {
  id             Int           @id @default(autoincrement())
  name           String        @db.VarChar(100)
  email          String        @unique @db.VarChar(150)
  username       String?       @unique @db.VarChar(100)
  phone          String?       @db.VarChar(20)
  roleId         Int           @map("role_id")
  role           Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status         AccountStatus @default(active)
  passwordHash   String?       @map("password_hash") @db.VarChar(100)
  sessionVersion Int           @default(0) @map("session_version")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  loginLogs      LoginLog[]
  auditLogs      AuditLog[]

  @@index([roleId])
  @@map("accounts")
}

model LoginLog {
  id        Int         @id @default(autoincrement())
  accountId Int?        @map("account_id")
  account   Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  email     String      @db.VarChar(150)
  ipAddress String?     @map("ip_address") @db.VarChar(60)
  status    LoginStatus
  loginAt   DateTime    @default(now()) @map("login_at") @db.Timestamptz(3)
  logoutAt  DateTime?   @map("logout_at") @db.Timestamptz(3)
  auditLogs AuditLog[]

  @@index([accountId])
  @@index([loginAt])
  @@map("login_logs")
}

model AuditLog {
  id          Int       @id @default(autoincrement())
  loginLogId  Int?      @map("login_log_id")
  session     LoginLog? @relation(fields: [loginLogId], references: [id], onDelete: SetNull)
  accountId   Int?      @map("account_id")
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  actorName   String    @map("actor_name") @db.VarChar(150)
  action      String    @db.VarChar(50)
  entityName  String    @map("entity_name") @db.VarChar(50)
  entityId    String?   @map("entity_id") @db.VarChar(50)
  description String    @default("")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([loginLogId])
  @@index([action])
  @@index([entityName])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemAdminCategory {
  id        Int            @id @default(autoincrement())
  type      String         @db.VarChar(100)
  name      String         @db.VarChar(150)
  status    CategoryStatus @default(active)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([type, name])
  @@map("system_admin_categories")
}

model SystemSetting {
  id             Int      @id @default(autoincrement())
  restaurantName String   @map("restaurant_name") @db.VarChar(150)
  email          String   @db.VarChar(150)
  phone          String?  @db.VarChar(20)
  currency       String   @default("VND") @db.VarChar(10)
  tax            Float    @default(8)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}


model MaterialAdjustment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String   @unique @db.VarChar(50)
  type             String   @db.VarChar(10)
  source           String   @db.VarChar(10)
  status           String   @default("PENDING") @db.VarChar(20)
  materialLotId    String   @map("material_lot_id") @db.Uuid
  locationId       String   @map("location_id") @db.Uuid
  issueDetailId    String?  @map("issue_detail_id") @db.Uuid
  quantity         Decimal  @db.Decimal(18, 3)
  acceptedQuantity Decimal? @map("accepted_quantity") @db.Decimal(18, 3)
  qualityStatus    String?  @map("quality_status") @db.VarChar(20)
  reason           String   @db.VarChar(500)
  decisionNote     String?  @map("decision_note") @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(3)

  materialLot MaterialLot @relation(fields: [materialLotId], references: [id], onDelete: Restrict)
  location    WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  issueDetail MaterialIssueDetail? @relation(fields: [issueDetailId], references: [id], onDelete: Restrict)
  movementLink MaterialAdjustmentMovement?

  @@index([type, status, createdAt])
  @@index([issueDetailId, status])
  @@map("material_adjustments")
}


model MaterialUsageSettlement {
  issueDetailId    String @id @map("issue_detail_id") @db.Uuid
  consumedQuantity Decimal @map("consumed_quantity") @db.Decimal(18, 3)
  finalizedAt     DateTime @map("finalized_at") @db.Timestamptz(3)
  referenceCode   String @map("reference_code") @db.VarChar(100)
  recordedBy      String @map("recorded_by") @db.VarChar(100)
  issueDetail     MaterialIssueDetail @relation(fields: [issueDetailId], references: [id], onDelete: Restrict)

  @@map("material_usage_settlements")
}


model MaterialAdjustmentMovement {
  adjustmentId String @id @map("adjustment_id") @db.Uuid
  movementId   String @unique @map("movement_id") @db.Uuid
  adjustment MaterialAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  movement InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@map("material_adjustment_movements")
}


enum StaffRole {
  SERVICE
  KITCHEN
  BARISTA
  CASHIER
  SUPERVISOR
}


enum InvoiceStatus {
  OPEN
  PAID
}


enum TicketStatus {
  QUEUED
  COOKING
  READY
  SERVED
  CANCELLED
}


model StaffUser {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  name String
  passwordHash String @map("password_hash")
  role StaffRole
  branchId String @db.Uuid @map("branch_id")
  isActive Boolean @default(true) @map("is_active")
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sessions StaffSession[]
  shifts StaffShift[]
  orders StaffOrder[]
  payments Payment[]
  audits StaffAudit[]
  @@map("staff_users")

  staff_kitchen_waste      staff_kitchen_waste[] @ignore
  staff_processing_defects staff_processing_defects[] @ignore
}


model StaffSession {
  tokenHash String @id @map("token_hash")
  userId String @db.Uuid @map("user_id")
  expiresAt DateTime @db.Timestamptz(3) @map("expires_at")
  user StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
  @@map("staff_sessions")
}


model MenuItem {
  id String @id @default(uuid()) @db.Uuid
  branchId String @db.Uuid @map("branch_id")
  name String
  category String
  description String @default("")
  price Int
  isAvailable Boolean @default(true) @map("is_available")
  // Cooking is blocked until the branch explicitly configures a recipe.
  recipeConfigured Boolean @default(false) @map("recipe_configured")
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  lines OrderLine[]
  recipe RecipeIngredient[]
  @@index([branchId])
  @@map("menu_items")

  staff_demo_order_recipes staff_demo_order_recipes[] @ignore
}


model Invoice {
  id String @id @default(uuid()) @db.Uuid
  branchId String @db.Uuid @map("branch_id")
  tableId String @db.Uuid @map("table_id")
  // Guest identity is a per-invoice label; no customer account is required.
  guestName String @map("guest_name")
  status InvoiceStatus @default(OPEN)
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  table RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Restrict)
  orders StaffOrder[]
  payment Payment?
  @@index([branchId, status])
  @@index([tableId])
  @@map("invoices")
}


model StaffOrder {
  id String @id @default(uuid()) @db.Uuid
  invoiceId String @db.Uuid @map("invoice_id")
  createdById String @db.Uuid @map("created_by_id")
  requestKey String @unique @map("request_key")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy StaffUser @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines OrderLine[]
  @@index([invoiceId])
  @@map("staff_orders")
}


model OrderLine {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid @map("order_id")
  menuItemId String @db.Uuid @map("menu_item_id")
  name String
  unitPrice Int @map("unit_price")
  quantity Int
  note String @default("")
  status TicketStatus @default(QUEUED)
  cookingAt DateTime? @db.Timestamptz(3) @map("cooking_at")
  readyAt DateTime? @db.Timestamptz(3) @map("ready_at")
  servedAt DateTime? @db.Timestamptz(3) @map("served_at")
  order StaffOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  consumption CookingConsumption?
  @@index([orderId])
  @@map("order_lines")

  staff_kitchen_order_consumptions                                                   staff_kitchen_order_consumptions[] @ignore
  staff_kitchen_waste                                                                staff_kitchen_waste[] @ignore
  staff_processing_defects_staff_processing_defects_order_line_idToorder_lines       staff_processing_defects[]         @relation("staff_processing_defects_order_line_idToorder_lines") @ignore
  staff_processing_defects_staff_processing_defects_retry_order_line_idToorder_lines staff_processing_defects[]         @relation("staff_processing_defects_retry_order_line_idToorder_lines") @ignore
}


model Payment {
  id String @id @default(uuid()) @db.Uuid
  invoiceId String @unique @db.Uuid @map("invoice_id")
  cashierId String @db.Uuid @map("cashier_id")
  amount Int
  cashReceived Int @map("cash_received")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  cashier StaffUser @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  @@map("payments")
}


model StaffShift {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid @map("user_id")
  startedAt DateTime @default(now()) @db.Timestamptz(3) @map("started_at")
  endedAt DateTime? @db.Timestamptz(3) @map("ended_at")
  handoverNote String? @map("handover_note")
  user StaffUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, startedAt])
  @@map("staff_shifts")
}


model StaffAudit {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid @map("actor_id")
  action String
  targetId String @map("target_id")
  detail String
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  actor StaffUser @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@map("staff_audits")
}


model Ingredient {
  id String @id @default(uuid()) @db.Uuid
  name String
  unit String
  recipe RecipeIngredient[]
  batches StockBatch[]
  @@map("ingredients")
}


model RecipeIngredient {
  menuItemId String @db.Uuid @map("menu_item_id")
  ingredientId String @db.Uuid @map("ingredient_id")
  quantity Decimal @db.Decimal(14, 3)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  @@id([menuItemId, ingredientId])
  @@map("recipe_ingredients")
}


model StockBatch {
  id String @id @default(uuid()) @db.Uuid
  branchId String @db.Uuid @map("branch_id")
  ingredientId String @db.Uuid @map("ingredient_id")
  code String
  remaining Decimal @db.Decimal(14, 3)
  expiresAt DateTime @db.Timestamptz(3) @map("expires_at")
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  movements StockConsumptionLine[]
  @@unique([branchId, code])
  @@index([branchId, ingredientId, expiresAt])
  @@map("stock_batches")
}


model CookingConsumption {
  // Shared idempotency point for cooking: integrations must reuse this ledger.
  id String @id @default(uuid()) @db.Uuid
  orderLineId String @unique @db.Uuid @map("order_line_id")
  createdAt DateTime @default(now()) @db.Timestamptz(3) @map("created_at")
  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  batches StockConsumptionLine[]
  @@map("cooking_consumptions")
}


model StockConsumptionLine {
  consumptionId String @db.Uuid @map("consumption_id")
  batchId String @db.Uuid @map("batch_id")
  quantity Decimal @db.Decimal(14, 3)
  consumption CookingConsumption @relation(fields: [consumptionId], references: [id], onDelete: Restrict)
  batch StockBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  @@id([consumptionId, batchId])
  @@map("stock_consumption_lines")
}


model StaffMaterialWaste {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  actorId String @map("actor_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  balanceId String @map("balance_id") @db.Uuid
  quantity Decimal @db.Decimal(18, 3)
  reason String @db.Text
  status String @default("PENDING")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  decisionNote String? @map("decision_note") @db.Text
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  movementId String? @unique @map("movement_id") @db.Uuid
  movement InventoryMovement? @relation(fields: [movementId], references: [id], onDelete: Restrict)
  @@index([actorId, branchId])
  @@map("staff_material_waste")
}


model StaffMaterialReturn {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  actorId String @map("actor_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  issueDetailId String @map("issue_detail_id") @db.Uuid
  quantity Decimal @db.Decimal(18, 3)
  note String? @db.Text
  condition String?
  conditionConfirmed Boolean @default(false) @map("condition_confirmed")
  stockReserved Boolean @default(false) @map("stock_reserved")
  decisionNote String? @db.Text @map("decision_note")
  decidedBy String? @map("decided_by")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  status String @default("PENDING")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  movementId String? @unique @map("movement_id") @db.Uuid
  movement InventoryMovement? @relation(fields: [movementId], references: [id], onDelete: Restrict)
  @@index([issueDetailId, status])
  @@map("staff_material_returns")

  issueDetail MaterialIssueDetail @relation(fields: [issueDetailId], references: [id], onUpdate: NoAction, map: "staff_material_returns_detail_fkey")
}


model staff_demo_order_recipes {
  menu_item_id String   @db.Uuid
  material_id  String   @db.Uuid
  quantity     Decimal  @db.Decimal(18, 3)
  materials    Material @relation(fields: [material_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  menu_items   MenuItem @relation(fields: [menu_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([menu_item_id, material_id])

  @@ignore
}


model staff_kitchen_balances {
  branch_id       String      @db.Uuid
  material_lot_id String      @db.Uuid
  quantity        Decimal     @default(0) @db.Decimal(18, 3)
  reserved_waste  Decimal     @default(0) @db.Decimal(18, 3)
  reserved_return Decimal     @default(0) @db.Decimal(18, 3)
  branches        Branch      @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  material_lots   MaterialLot @relation(fields: [material_lot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([branch_id, material_lot_id])

  @@ignore
}


model staff_kitchen_order_consumptions {
  order_line_id   String      @db.Uuid
  material_lot_id String      @db.Uuid
  quantity        Decimal     @db.Decimal(18, 3)
  material_lots   MaterialLot @relation(fields: [material_lot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order_lines     OrderLine   @relation(fields: [order_line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([order_line_id, material_lot_id])

  @@ignore
}


model staff_kitchen_production_consumptions {
  production_order_id       String                @db.Uuid
  material_lot_id           String                @db.Uuid
  quantity                  Decimal               @db.Decimal(18, 3)
  finished_goods_receipt_id String?               @db.Uuid
  material_lots             MaterialLot           @relation(fields: [material_lot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  production_orders         ProductionOrder       @relation(fields: [production_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  finished_goods_receipts   FinishedGoodsReceipt? @relation(fields: [finished_goods_receipt_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "staff_kitchen_production_consumptions_receipt_id_fkey")

  @@ignore
  // The conditional receipt/lot unique index is managed by migration 20261105160000.
}


model staff_kitchen_production_starts {
  production_order_id String          @id @db.Uuid
  branch_id           String          @db.Uuid
  reported_quantity   Decimal?        @db.Decimal(18, 3)
  created_at          DateTime        @default(now()) @db.Timestamptz(3)
  branches            Branch          @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  production_orders   ProductionOrder @relation(fields: [production_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@ignore
}


model staff_kitchen_receipts {
  issue_detail_id        String                 @id @db.Uuid
  branch_id              String                 @db.Uuid
  material_lot_id        String                 @db.Uuid
  quantity               Decimal                @db.Decimal(18, 3)
  created_at             DateTime               @default(now()) @db.Timestamptz(3)
  branches               Branch                 @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  material_issue_details MaterialIssueDetail    @relation(fields: [issue_detail_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  material_lots          MaterialLot            @relation(fields: [material_lot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff_kitchen_sources  staff_kitchen_sources? @ignore

  @@ignore
}


model staff_kitchen_source_allocations {
  issue_detail_id       String                @db.Uuid
  event_type            String
  event_key             String
  quantity              Decimal               @db.Decimal(18, 3)
  staff_kitchen_sources staff_kitchen_sources @relation(fields: [issue_detail_id], references: [issue_detail_id], onDelete: NoAction, onUpdate: NoAction) @ignore

  @@id([issue_detail_id, event_type, event_key])
  @@index([event_type, event_key], map: "staff_kitchen_alloc_event_idx")

  @@ignore
}


model staff_kitchen_sources {
  issue_detail_id                  String                             @id @db.Uuid
  branch_id                        String                             @db.Uuid
  material_lot_id                  String                             @db.Uuid
  received                         Decimal                            @db.Decimal(18, 3)
  available                        Decimal                            @db.Decimal(18, 3)
  received_at                      DateTime                           @db.Timestamptz(3)
  source_seq                       BigInt                             @unique(map: "staff_kitchen_sources_sequence_idx") @default(autoincrement())
  staff_kitchen_source_allocations staff_kitchen_source_allocations[] @ignore
  branches                         Branch                             @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff_kitchen_receipts           staff_kitchen_receipts             @relation(fields: [issue_detail_id], references: [issue_detail_id], onDelete: NoAction, onUpdate: NoAction) @ignore
  material_lots                    MaterialLot                        @relation(fields: [material_lot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([branch_id, material_lot_id, received_at, issue_detail_id], map: "staff_kitchen_sources_fifo_idx")

  @@ignore
}


model staff_kitchen_waste {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                     String                    @unique
  actor_id                 String                    @db.Uuid
  branch_id                String                    @db.Uuid
  material_lot_id          String                    @db.Uuid
  order_line_id            String?                   @db.Uuid
  quantity                 Decimal                   @db.Decimal(18, 3)
  reason                   String
  created_at               DateTime                  @default(now()) @db.Timestamptz(3)
  status                   String                    @default("RECORDED")
  decision_note            String?
  decided_by               String?
  processed_at             DateTime?                 @db.Timestamptz(3)
  processing_defect_id     String?                   @db.Uuid
  staff_users              StaffUser                 @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branches                 Branch                    @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  material_lots            MaterialLot               @relation(fields: [material_lot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order_lines              OrderLine?                @relation(fields: [order_line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff_processing_defects staff_processing_defects? @relation(fields: [processing_defect_id], references: [id], onDelete: NoAction, onUpdate: NoAction) @ignore

  @@index([branch_id, status, created_at], map: "staff_kitchen_waste_branch_status_idx")

  @@ignore
}


model staff_processing_defects {
  id                                                                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                                                                  String                @unique
  actor_id                                                              String                @db.Uuid
  branch_id                                                             String                @db.Uuid
  order_line_id                                                         String?               @db.Uuid
  production_order_id                                                   String?               @db.Uuid
  quantity                                                              Decimal               @db.Decimal(18, 3)
  reason                                                                String
  status                                                                String                @default("PENDING")
  decision_note                                                         String?
  decided_by                                                            String?
  created_at                                                            DateTime              @default(now()) @db.Timestamptz(3)
  processed_at                                                          DateTime?             @db.Timestamptz(3)
  retry_order_line_id                                                   String?               @db.Uuid
  staff_kitchen_waste                                                   staff_kitchen_waste[] @ignore
  staff_users                                                           StaffUser             @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branches                                                              Branch                @relation(fields: [branch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
