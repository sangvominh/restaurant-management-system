  order_lines_staff_processing_defects_retry_order_line_idToorder_lines OrderLine?            @relation("staff_processing_defects_retry_order_line_idToorder_lines", fields: [retry_order_line_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([branch_id, status, created_at], map: "staff_processing_defect_status_idx")

  @@ignore
