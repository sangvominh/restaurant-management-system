// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(30)
  name      String   @db.VarChar(200)
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tables             RestaurantTable[]
  warehouseLocations WarehouseLocation[]
  goodsReceipts      GoodsReceipt[]

  @@map("branches")
}

model RestaurantTable {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  code      String   @db.VarChar(30)
  name      String   @db.VarChar(100)
  capacity  Int
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([branchId, code])
  @@map("restaurant_tables")
}

model Unit {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String  @unique @db.VarChar(50)
  baseUnitId       String? @map("base_unit_id") @db.Uuid
  conversionFactor Decimal @default(1) @map("conversion_factor") @db.Decimal(18, 6)
  status           String  @default("ACTIVE") @db.VarChar(20)

  baseUnit     Unit?  @relation("UnitConversion", fields: [baseUnitId], references: [id], onDelete: Restrict)
  derivedUnits Unit[] @relation("UnitConversion")

  materials           Material[]
  goodsReceiptDetails GoodsReceiptDetail[]

  @@map("units")
}

model Category {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String @db.VarChar(100)
  categoryType String @map("category_type") @db.VarChar(30)
  status       String @default("ACTIVE") @db.VarChar(20)

  materials Material[]

  @@unique([name, categoryType])
  @@map("categories")
}

model Material {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String  @unique @db.VarChar(30)
  name     String  @db.VarChar(200)
  minStock Decimal @default(0) @map("min_stock") @db.Decimal(18, 3)
  status   String  @default("ACTIVE") @db.VarChar(20)

  unitId     String @map("unit_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  unit                Unit                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  category            Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  lots                MaterialLot[]
  goodsReceiptDetails GoodsReceiptDetail[]

  @@index([categoryId])
  @@map("materials")
}

model WarehouseLocation {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId     String @map("branch_id") @db.Uuid
  name         String @db.VarChar(150)
  locationType String @map("location_type") @db.VarChar(30)

  branch              Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  balances            MaterialBalance[]
  goodsReceiptDetails GoodsReceiptDetail[]
  inventoryMovements  InventoryMovement[]

  @@unique([branchId, name])
  @@map("warehouse_locations")
}

model MaterialLot {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId String    @map("material_id") @db.Uuid
  lotCode    String    @map("lot_code") @db.VarChar(50)
  expiryDate DateTime? @map("expiry_date") @db.Date
  status     String    @default("ACTIVE") @db.VarChar(20)

  material            Material             @relation(fields: [materialId], references: [id], onDelete: Restrict)
  balances            MaterialBalance[]
  goodsReceiptDetails GoodsReceiptDetail[]
  inventoryMovements  InventoryMovement[]

  @@unique([materialId, lotCode])
  @@map("material_lots")
}

model MaterialBalance {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  locationId    String  @map("location_id") @db.Uuid
  materialLotId String  @map("material_lot_id") @db.Uuid
  quantity      Decimal @default(0) @db.Decimal(18, 3)

  location    WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  materialLot MaterialLot       @relation(fields: [materialLotId], references: [id], onDelete: Restrict)

  @@unique([locationId, materialLotId])
  @@map("material_balances")
}

model Supplier {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code    String  @unique @db.VarChar(30)
  name    String  @db.VarChar(200)
  phone   String? @db.VarChar(20)
  email   String? @db.VarChar(150)
  address String?
  status  String  @default("ACTIVE") @db.VarChar(20)

  receipts GoodsReceipt[]

  @@map("suppliers")
}

model GoodsReceipt {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptCode String    @unique @map("receipt_code") @db.VarChar(50)
  supplierId  String    @map("supplier_id") @db.Uuid
  branchId    String    @map("branch_id") @db.Uuid
  status      String    @default("DRAFT") @db.VarChar(20)
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  postedAt    DateTime? @map("posted_at") @db.Timestamptz(3)

  supplier Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch   Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  details  GoodsReceiptDetail[]

  @@index([branchId, createdAt])
  @@map("goods_receipts")
}

model GoodsReceiptDetail {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId     String  @map("receipt_id") @db.Uuid
  materialId    String  @map("material_id") @db.Uuid
  materialLotId String  @map("material_lot_id") @db.Uuid
  locationId    String  @map("location_id") @db.Uuid
  unitId        String  @map("unit_id") @db.Uuid
  quantity      Decimal @db.Decimal(18, 3)
  unitPrice     Decimal @map("unit_price") @db.Decimal(18, 2)

  receipt     GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  material    Material          @relation(fields: [materialId], references: [id], onDelete: Restrict)
  materialLot MaterialLot       @relation(fields: [materialLotId], references: [id], onDelete: Restrict)
  location    WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  unit        Unit              @relation(fields: [unitId], references: [id], onDelete: Restrict)

  movement InventoryMovement?

  @@index([receiptId])
  @@map("goods_receipt_details")
}

model InventoryMovement {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptDetailId String?  @unique @map("receipt_detail_id") @db.Uuid
  materialLotId   String   @map("material_lot_id") @db.Uuid
  locationId      String   @map("location_id") @db.Uuid
  movementType    String   @map("movement_type") @db.VarChar(30)
  quantityBefore  Decimal  @map("quantity_before") @db.Decimal(18, 3)
  quantityChange  Decimal  @map("quantity_change") @db.Decimal(18, 3)
  quantityAfter   Decimal  @map("quantity_after") @db.Decimal(18, 3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  receiptDetail GoodsReceiptDetail? @relation(fields: [receiptDetailId], references: [id], onDelete: Restrict)
  materialLot   MaterialLot         @relation(fields: [materialLotId], references: [id], onDelete: Restrict)
  location      WarehouseLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([materialLotId, locationId])
  @@map("inventory_movements")
}
